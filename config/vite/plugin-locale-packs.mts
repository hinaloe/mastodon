/* Generates one entrypoint per web UI locale (`packs/locales/locale_<code>.js`),
   like `config/webpack/generateLocalePacks.js` did for Webpack.

   Each entrypoint registers the messages and the react-intl locale data
   with `setLocale()`. Layouts load it with
   `vite_javascript_tag "locales/locale_#{I18n.locale}"` before the
   application entrypoints, so `getLocale()` works when those modules are
   evaluated.

   The files are written when the configuration is loaded, so this plugin must
   be listed before `vite-plugin-ruby`, which collects the entrypoints.
   The generated directory is ignored by Git.
*/

import fs from 'node:fs';
import path from 'node:path';

import type { Plugin } from 'vite';

export function MastodonLocalePacks({
  root,
  projectRoot,
}: {
  root: string;
  projectRoot: string;
}): Plugin {
  const localesDir = path.resolve(root, 'mastodon/locales');
  const outDir = path.resolve(root, 'packs/locales');

  const generate = () => {
    const locales = fs
      .readdirSync(localesDir)
      .filter(
        (filename) =>
          filename.endsWith('.json') &&
          !/defaultMessages|whitelist/.test(filename),
      )
      .map((filename) => filename.replace(/\.json$/, ''))
      .sort();

    fs.rmSync(outDir, { recursive: true, force: true });
    fs.mkdirSync(outDir, { recursive: true });

    for (const locale of locales) {
      const baseLocale = locale.split('-')[0];

      // first try react-intl, then locales/locale-data, then fall back to English
      const localeData =
        [
          `react-intl/locale-data/${baseLocale}.js`,
          `../../mastodon/locales/locale-data/${baseLocale}.js`,
        ].find((candidate) =>
          fs.existsSync(
            candidate.startsWith('.')
              ? path.resolve(outDir, candidate)
              : path.resolve(projectRoot, 'node_modules', candidate),
          ),
        ) ?? 'react-intl/locale-data/en.js';

      const content = `//
// locale_${locale}.js
// automatically generated by config/vite/plugin-locale-packs.mts
//
import messages from '../../mastodon/locales/${locale}.json';
import localeData from ${JSON.stringify(localeData)};
import { setLocale } from '../../mastodon/locales';
setLocale({ messages, localeData });
`;

      fs.writeFileSync(path.resolve(outDir, `locale_${locale}.js`), content);
    }
  };

  generate();

  return {
    name: 'mastodon-locale-packs',
  };
}
