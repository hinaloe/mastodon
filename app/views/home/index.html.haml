- content_for :header_tags do
  = vite_preload_chunk_tag 'mastodon/features/getting_started/index.js'
  = vite_preload_chunk_tag 'mastodon/features/compose/index.js'
  = vite_preload_chunk_tag 'mastodon/features/home_timeline/index.js'
  = vite_preload_chunk_tag 'mastodon/features/notifications/index.js'

  %meta{name: 'applicationServerKey', content: Rails.configuration.x.vapid_public_key}
  = render_initial_state
  = vite_javascript_tag 'application', crossorigin: 'anonymous'

.notranslate.app-holder#mastodon{ data: { props: Oj.dump(default_props) } }
  %noscript
    = vite_image_tag 'images/logo.svg', alt: 'Mastodon'

    %div
      = t('errors.noscript_html', apps_path: 'https://joinmastodon.org/apps')
