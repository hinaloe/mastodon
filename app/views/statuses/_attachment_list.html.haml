.attachment-list
  .attachment-list__icon
    = fa_icon 'link'
  %ul.attachment-list__list
    - attachments.each do |media|
      %li
        - url = media.remote_url.presence if media.remote_url&.start_with?('http://', 'https://')
        - url ||= media.file.url
        = link_to File.basename(url), url, title: media.description
